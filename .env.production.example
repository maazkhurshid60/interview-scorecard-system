# =============================================================================
# PRODUCTION environment  (backend: api.ownerstalent.com, Lightsail + Nginx)
# =============================================================================
# This file is a TEMPLATE. It contains NO real secrets and is safe to commit.
#   - Replace every value marked  CHANGE_ME  (secrets / account-specific).
#   - Never commit the filled-in copy. Never reuse a staging value here.
#   - Set these as real environment variables on the server (PM2 / systemd
#     EnvironmentFile with owner-only permissions, or AWS Secrets Manager), OR
#     save the filled-in copy as `.env` in the repository ROOT on the server
#     (the backend reads <repo-root>/.env) and run: chmod 600 .env
#   - A value that contains # or spaces must be wrapped in "double quotes".
#   - Restart the backend after any change.
# =============================================================================


# ----------------------------- Server ----------------------------------------
# MUST be exactly "production": it selects S3 file storage, attaches offer
# letters to emails as PDFs, and turns on the proxy setting below.
NODE_ENV=production
PORT=5000

# Number of reverse proxies in front of Node. Nginx only = 1.
# (Nginx + a load balancer / CloudFront = 2.) Wrong value = rate limits count the
# wrong address.
TRUST_PROXY_HOPS=1

# The website's main address. ONE address, used to build links in emails and Slack
# messages (https, no path, no trailing slash).
CLIENT_URL=https://app.ownerstalent.com

# Websites allowed to call this API from a browser (CORS). Comma-separated list of
# origins: https://host only, no path, no trailing slash, no wildcard (*).
# Only these websites can talk to the API. Add a second one only if really needed.
# (If this is left empty the API falls back to CLIENT_URL.)
ALLOWED_ORIGINS=https://app.ownerstalent.com


# ----------------------------- Database (MongoDB Atlas) ----------------------
# CHANGE_ME: use the dedicated production database user. URL-encode special
# characters in the password. Allow only the Lightsail static IP in Atlas.
MONGODB_URI=mongodb+srv://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_CLUSTER.mongodb.net/owners-talent-production?retryWrites=true&w=majority


# ----------------------------- Login security --------------------------------
# CHANGE_ME: long random value, DIFFERENT from staging. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs every user out.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
# Password-reset link lifetime in minutes (5-120)
PASSWORD_RESET_TTL_MINUTES=30

# Login session lifetimes. Staff stay signed in through two HTTP-only cookies:
# a short-lived access token that is renewed silently in the background, and a
# longer-lived refresh token. Defaults shown; all optional.
ACCESS_TOKEN_MINUTES=15
# Signed out after this many days WITHOUT using the site
REFRESH_TOKEN_DAYS=7
# Absolute limit: must sign in again this many days after the original login
REFRESH_TOKEN_MAX_DAYS=30
# Cookies are marked Secure (HTTPS only) in production. app. and api.ownerstalent.com
# are the same site, so "lax" is right. Do not change it unless the website and the
# API end up on different domains (then "none").
COOKIE_SAMESITE=lax


# ----------------------------- Claude (AI scoring) ---------------------------
# CHANGE_ME: a PRODUCTION-ONLY key (not the staging key). Also set a monthly
# spend limit for this key in the Anthropic console.
ANTHROPIC_API_KEY=CHANGE_ME
# Verify these model names in the Anthropic console, then use Settings >
# Integrations > "Test connection" after deploying. A wrong name = AI scoring fails.
# Every stage uses the CHEAP tier by default.
CLAUDE_MODEL_CHEAP=claude-haiku-5-5
CLAUDE_MODEL_DEFAULT=claude-sonnet-5-5
CLAUDE_MODEL_DEEP=claude-opus-5-5
# NOTE: these three values (and the thresholds/limits further down) are copied into
# the database the FIRST time the seed script runs. After that, changing them
# here has no effect: change them on the Settings page instead.


# ----------------------------- Google Meet + Calendar ------------------------
# The Google Cloud project must be an INTERNAL app (or published), otherwise the
# refresh token expires after 7 days and meetings stop working.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
# Must be added to the OAuth client's "Authorized redirect URIs" in Google Cloud.
GOOGLE_REDIRECT_URI=https://api.ownerstalent.com/api/interviews/google/callback
# CHANGE_ME: generate with the Google OAuth Playground using the company HR account.
# Required scopes: calendar.events, meetings.space.created, meetings.space.readonly
GOOGLE_REFRESH_TOKEN=CHANGE_ME
GOOGLE_CALENDAR_TIME_ZONE=Asia/Karachi
# CHANGE_ME: company address that receives "interview scheduled / cancelled" notices
GOOGLE_CALENDAR_HOST_EMAIL=CHANGE_ME@ownerstalent.com
ACTIVE_TRANSCRIPT_PROVIDER=google_meet


# ----------------------------- Slack (optional) ------------------------------
# CHANGE_ME: webhook of the PRODUCTION channel. Leave empty to turn Slack off.
SLACK_WEBHOOK_URL=


# ----------------------------- File storage: Amazon S3 -----------------------
# NODE_ENV=production selects S3 automatically. Do NOT set STORAGE_PROVIDER here.
# Bucket must be PRIVATE (Block all public access = ON).
AWS_REGION=CHANGE_ME_for_example_eu-west-1
S3_BUCKET=CHANGE_ME_bucket_name
# Lightsail has no instance role, so use an IAM user allowed ONLY
# s3:PutObject, s3:GetObject, s3:DeleteObject on this one bucket.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Largest PDF accepted (MB). The browser check is fixed at 5, so keep this at 5.
MAX_UPLOAD_PDF_MB=5
# (Cloudinary is staging-only: no CLOUDINARY_* values are needed in production.)


# ----------------------------- Email ------------------------------------------
# The backend currently sends mail through Gmail / Google Workspace ONLY.
# Use a company-domain Workspace mailbox (for example hr@ownerstalent.com) with an
# App Password (requires 2-step verification). Never the mailbox's normal password.
# Amazon SES / generic SMTP is NOT supported by the code yet: SMTP_* variables
# would be ignored.
GMAIL_USER=CHANGE_ME@ownerstalent.com
GMAIL_APP_PASSWORD=CHANGE_ME_16_CHARACTER_APP_PASSWORD


# ----------------------------- Bot protection (Cloudflare Turnstile) ---------
# REQUIRED in production. If either is empty the CAPTCHA is silently switched
# off and the public application form can be abused. Create a production widget
# and add app.ownerstalent.com as an allowed domain.
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME


# ----------------------------- Hiring / scoring defaults ----------------------
DEFAULT_HIRE_THRESHOLD=3.5
DEFAULT_MAYBE_THRESHOLD=3.0
# Days after a job is closed before transcripts / files are deleted (0 = never)
TRANSCRIPT_RETENTION_DAYS=90
# Offices for onsite / hybrid jobs, separated by |   (CHANGE_ME)
REGISTERED_OFFICE_LOCATIONS=CHANGE_ME Office - Full address|CHANGE_ME Second Office - Full address


# ----------------------------- AI spend controls -----------------------------
MONTHLY_AI_SPEND_CAP_USD=200
AI_SPEND_WARN_PERCENT=80


# ----------------------------- Offer letter templates ------------------------
# Offer letters made from templates are Word files turned into PDFs by LibreOffice,
# so LibreOffice must be installed on the server (Ubuntu: sudo apt install libreoffice-writer).
# Leave both lines out to use the defaults (the usual install folders, and server/templates/offer-letters).
# LIBREOFFICE_PATH=/usr/bin/soffice
# OFFER_TEMPLATES_DIR=/home/ubuntu/offer-letter-templates


# ----------------------------- First-run owner (seed) ------------------------
# Used ONLY by `npm run seed` to create the first owner account. Use a strong
# password, change it after first login, then REMOVE these three lines.
#
# WARNING: the seed script ALSO creates three demo accounts (hiring manager,
# recruiter, interviewer) with the well-known password 12345678. Either do not
# run the seed in production, or delete those three users straight afterwards.
SEED_OWNER_NAME=CHANGE_ME
SEED_OWNER_EMAIL=CHANGE_ME@ownerstalent.com
SEED_OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
