# Server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/Database_Name
JWT_SECRET=change_this_to_a_long_random_string

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL_DEFAULT=claude-sonnet-x
CLAUDE_MODEL_CHEAP=claude-haiku-4-x-20251001
CLAUDE_MODEL_DEEP=claude-opus-x

# Google Meet (Conference Records REST API) — OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/interviews/google/callback
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Transcript provider (Phase 1 = google_meet only; zoom / fathom in Phase 2)
ACTIVE_TRANSCRIPT_PROVIDER=google_meet

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Cloudinary (résumé / interview-artifact file storage — Render's filesystem is ephemeral)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend base URL (used to build links in Slack notifications) - added; not in original INSTRUCTIONS.md env list
CLIENT_URL=http://localhost:xxxx

# Scoring defaults (1-5 scale)
DEFAULT_HIRE_THRESHOLD=3.5
DEFAULT_MAYBE_THRESHOLD=3.0

# Retention (days after a requisition is CLOSED; 0 = never delete)
TRANSCRIPT_RETENTION_DAYS=90

# Token / cost controls
MONTHLY_AI_SPEND_CAP_USD=200
AI_SPEND_WARN_PERCENT=80

# Seed script (default admin login — change after first login)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_this_password
