# =============================================================================
# STAGING environment
# =============================================================================
# This file is a TEMPLATE. It contains NO real secrets and is safe to commit.
#   - Replace every value marked  CHANGE_ME.
#   - Staging uses its OWN database, its OWN keys, and Cloudinary for files.
#     Never copy production keys or the production database here.
#   - Set these as real environment variables on the staging server, or save the
#     filled-in copy as `.env` in the repository ROOT on the staging server.
#   - A value that contains # or spaces must be wrapped in "double quotes".
#   - Restart the backend after any change.
# =============================================================================


# ----------------------------- Server ----------------------------------------
# Anything EXCEPT "production" selects Cloudinary for files and sends offer
# letters as a link. Never set NODE_ENV=production on staging.
NODE_ENV=staging
PORT=5000

# Number of reverse proxies in front of Node (Render / Nginx = 1).
TRUST_PROXY_HOPS=1

# CHANGE_ME: the staging WEBSITE's main address. ONE address, used to build links
# in emails and Slack messages (https, no path, no trailing slash).
CLIENT_URL=https://CHANGE_ME-staging-web-address

# CHANGE_ME: websites allowed to call this API from a browser (CORS). Comma-separated
# list of origins: https://host only, no path, no trailing slash, no wildcard (*).
# (If this is left empty the API falls back to CLIENT_URL.)
ALLOWED_ORIGINS=https://CHANGE_ME-staging-web-address


# ----------------------------- Database (MongoDB Atlas) ----------------------
# CHANGE_ME: a SEPARATE staging database (different from production).
MONGODB_URI=mongodb+srv://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_CLUSTER.mongodb.net/owners-talent-staging?retryWrites=true&w=majority


# ----------------------------- Login security --------------------------------
# CHANGE_ME: long random value, DIFFERENT from production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
PASSWORD_RESET_TTL_MINUTES=30

# Login session lifetimes. Staff stay signed in through two HTTP-only cookies:
# a short-lived access token that is renewed silently in the background, and a
# longer-lived refresh token. Defaults shown; all optional.
ACCESS_TOKEN_MINUTES=15
# Signed out after this many days WITHOUT using the site
REFRESH_TOKEN_DAYS=7
# Absolute limit: must sign in again this many days after the original login
REFRESH_TOKEN_MAX_DAYS=30
# Use "lax" when the staging website and API share a parent domain (for example
# staging-app.example.com + staging-api.example.com). If they are on DIFFERENT
# domains (for example Vercel + Render) use "none" (cookies become Secure; some
# browsers, notably Safari, may still block them: prefer one parent domain).
COOKIE_SAMESITE=lax


# ----------------------------- Claude (AI scoring) ---------------------------
# CHANGE_ME: a STAGING-ONLY key with a small spend limit (not the production key).
ANTHROPIC_API_KEY=CHANGE_ME
# Verify these model names in the Anthropic console (Settings > "Test connection").
CLAUDE_MODEL_CHEAP=claude-haiku-5-5
CLAUDE_MODEL_DEFAULT=claude-sonnet-5-5
CLAUDE_MODEL_DEEP=claude-opus-5-5
# NOTE: copied into the database the first time the seed runs; after that change
# them on the Settings page.


# ----------------------------- Google Meet + Calendar ------------------------
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
# CHANGE_ME: staging API address; add it to the OAuth client's redirect URIs.
GOOGLE_REDIRECT_URI=https://CHANGE_ME-staging-api-address/api/interviews/google/callback
GOOGLE_REFRESH_TOKEN=CHANGE_ME
GOOGLE_CALENDAR_TIME_ZONE=Asia/Karachi
GOOGLE_CALENDAR_HOST_EMAIL=CHANGE_ME@ownerstalent.com
ACTIVE_TRANSCRIPT_PROVIDER=google_meet


# ----------------------------- Slack (optional) ------------------------------
# CHANGE_ME: a TEST channel webhook, not the production one. Empty = Slack off.
SLACK_WEBHOOK_URL=


# ----------------------------- File storage: Cloudinary ----------------------
# NODE_ENV is not "production", so Cloudinary is selected automatically.
# Do NOT set STORAGE_PROVIDER, AWS_REGION, S3_BUCKET or AWS keys on staging.
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
# Largest PDF accepted (MB). The browser check is fixed at 5, so keep this at 5.
MAX_UPLOAD_PDF_MB=5


# ----------------------------- Email (Gmail) ----------------------------------
# CHANGE_ME: a Gmail / Workspace account with an App Password (2-step verification
# required). Staging emails go to REAL addresses: test with your own inbox only.
GMAIL_USER=CHANGE_ME@gmail.com
GMAIL_APP_PASSWORD=CHANGE_ME_16_CHARACTER_APP_PASSWORD


# ----------------------------- Bot protection (Cloudflare Turnstile) ---------
# Separate staging widget (allowed domain = the staging website). Empty = CAPTCHA off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ----------------------------- Hiring / scoring defaults ----------------------
DEFAULT_HIRE_THRESHOLD=3.5
DEFAULT_MAYBE_THRESHOLD=3.0
TRANSCRIPT_RETENTION_DAYS=90
REGISTERED_OFFICE_LOCATIONS=CHANGE_ME Test Office - Address


# ----------------------------- AI spend controls -----------------------------
# Keep staging small.
MONTHLY_AI_SPEND_CAP_USD=20
AI_SPEND_WARN_PERCENT=80


# ----------------------------- Offer letter templates ------------------------
# Offer letters made from templates are Word files turned into PDFs by LibreOffice,
# so LibreOffice must be installed on the server (Ubuntu: sudo apt install libreoffice-writer).
# Leave both lines out to use the defaults (the usual install folders, and server/templates/offer-letters).
# LIBREOFFICE_PATH=/usr/bin/soffice
# OFFER_TEMPLATES_DIR=/home/ubuntu/offer-letter-templates


# ----------------------------- First-run owner (seed) ------------------------
# Used by `npm run seed`. Staging only: the seed also creates three demo accounts
# (password 12345678), which is acceptable on staging but never on production.
SEED_OWNER_NAME=Admin
SEED_OWNER_EMAIL=CHANGE_ME@ownerstalent.com
SEED_OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
