# Full URL of the backend API. Vite bakes this in at BUILD time (not
# read at runtime) — changing it means running `npm run build` again,
# not just editing this file on an already-built deployment.
#
# Local dev:  http://localhost:5000/api
# Production: https://your-production-domain.example.com/api
VITE_API_URL=http://localhost:5000/api
