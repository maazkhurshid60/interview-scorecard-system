# STAGING frontend
# TEMPLATE, safe to commit. Set in the staging host's environment variables.
# Vite builds this value INTO the website: changing it needs a new build/deploy.
# Anything starting with VITE_ is visible to everyone in the browser: never put a secret here.
# CHANGE_ME: staging API address, ending with /api
VITE_API_URL=https://CHANGE_ME-staging-api-address/api
